{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/examples/manifest_net.json",
		"$(MODDABLE)/modules/base/deepEqual",
		"$(MODDABLE)/modules/base/structuredClone",
		"$(MODDABLE)/modules/base/modules",
		"$(MODDABLE)/modules/embedded/storage/key-value",
		"$(MODDABLE)/modules/embedded/io",
		"$(MODDABLE)/modules/web/console",
		"$(MODDABLE)/modules/web/timers"
 	],
	"modules": {
		"*": [
			"./nodered"
		]
	},
	"preload": [
		"nodered"
	],
	"defines": {
		"xs": {
			"xsbug_hooks": 1
		}
	},
	"config": {
		"noderedmcu": {
			"editor": true
		},
		"sntp": "pool.ntp.org"
	},
	"platforms": {
		"win": {
			"error": "Node-RED MCU does not currently run on Windows simulator. You can still build for device targets."
		},
		"esp": {
			"modules": {
				"~": [
					"$(BUILD)/devices/esp/setup/network"
				],
				"setup/network": "./setupwifi",
				"setup/timezone": "./setuptimezone"
			},
			"preload": [
				"setup/timezone"
			]
		},
		"esp32": {
			"modules": {
				"~": [
					"$(BUILD)/devices/esp32/setup/network"
				],
				"setup/network": "./setupwifi",
				"setup/timezone": "./setuptimezone"
			},
			"preload": [
				"setup/timezone"
			]
		},
		"pico": {
			"modules": {
				"~": [
					"$(BUILD)/devices/pico/setup/network"
				],
				"setup/network": "./setupwifi",
				"setup/timezone": "./setuptimezone"
			},
			"preload": [
				"setup/timezone"
			]
		}
	}	
}
