{
	"include": [
		"$(MODDABLE)/modules/embedded/network/http/client",
		"$(MODDABLE)/modules/data/wavreader",
		"$(MODDABLE)/modules/data/url"
	],
	"modules": {
		"audioout": "./audioout",
		"pins/*": [
			"$(MODULES)/pins/i2s/*"
		],
		"*": [
			"$(MODDABLE)/examples/pins/audioout/http-stream/wavstreamer",
			"$(MODDABLE)/examples/pins/audioout/http-stream/sbcstreamer"
		]
	},
	"preload": [
		"audioout",
		"pins/audioout",
		"wavstreamer",
		"sbcstreamer"
	],
	"defines": {
		"audioOut": {
			"bitsPerSample": 16,
			"numChannels": 1,
			"sampleRate": 16000,
			"queueLength": 24
		}
	},
	"config": {
		"startupSound": false
	}
}
