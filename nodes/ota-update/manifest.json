{
	"include": [
		"$(MODDABLE)/modules/data/url/manifest.json",
		"$(MODDABLE)/modules/embedded/network/http/client",
		"$(NODEREDMCU)/nodes/network/httpserver/manifest.json"
	],
	"modules": {
		"*": "./ota-update"
	},
	"preload": [
		"ota-update"
	],
	"platforms": {
		"esp32": {
			"include": [
				"$(EMBEDDED)/storage/flash",
				"$(EMBEDDED)/update"
			]
		},
		"esp8266": {
			"include": [
				"$(EMBEDDED)/storage/flash",
				"$(EMBEDDED)/update"
			]
		},
		"mac": {
			"include": [
				"$(EMBEDDED)/storage/flash",
				"$(EMBEDDED)/update"
			]
		},
		"...": {
			"warning": "OTA not supported"
		}
	}
}
